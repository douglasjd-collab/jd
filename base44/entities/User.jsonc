{
  "name": "User",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa \u00e0 qual o usu\u00e1rio pertence"
    },
    "empresa_nome": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "perfil": {
      "type": "string",
      "enum": [
        "master",
        "super_admin",
        "admin",
        "gerente",
        "vendedor"
      ],
      "default": "vendedor",
      "description": "Perfil do usu\u00e1rio"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do usu\u00e1rio"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social"
    },
    "nome_perfil": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone"
    },
    "foto_perfil": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "gerente_id": {
      "type": "string",
      "description": "ID do gerente"
    },
    "gerente_nome": {
      "type": "string",
      "description": "Nome do gerente"
    },
    "codigo_vendedor": {
      "type": "string",
      "description": "C\u00f3digo do vendedor"
    },
    "chave_pix": {
      "type": "string",
      "description": "Chave PIX"
    },
    "tipo_chave_pix": {
      "type": "string",
      "enum": [
        "cpf",
        "email",
        "telefone",
        "aleatoria"
      ],
      "description": "Tipo da chave PIX"
    },
    "banco": {
      "type": "string",
      "description": "Banco"
    },
    "saldo_comissao": {
      "type": "number",
      "default": 0,
      "description": "Saldo de comiss\u00f5es"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    },
    "whatsapp_permissoes_json": {
      "type": "string",
      "description": "Espelho (JSON) do n\u00edvel de acesso do usu\u00e1rio por conex\u00e3o de WhatsApp. Gravado apenas pelo backend \u2014 \u00e9 o que a RLS de conversas e mensagens consulta."
    },
    "whatsapp_restrito": {
      "type": "boolean",
      "default": false,
      "description": "Verdadeiro quando o usu\u00e1rio tem ao menos uma conex\u00e3o com acesso restrito. Gravado apenas pelo backend."
    }
  },
  "required": [
    "perfil"
  ],
  "security": {
    "read": {
      "rule": "if (user.role === 'admin') return true; if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (record.id === user.id) return true; var empresa = user.empresa_id || (user.data || {}).empresa_id; if (!empresa) return false; return record.empresa_id === empresa;"
    },
    "create": {
      "rule": "return user.role === 'admin';"
    },
    "update": {
      "rule": "if (user.role === 'admin') return true; if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (['admin', 'gerente'].indexOf(user.perfil) !== -1) { var empresa = user.empresa_id || (user.data || {}).empresa_id; return !!empresa && record.empresa_id === empresa; } return false;"
    },
    "delete": {
      "rule": "return user.role === 'admin';"
    }
  }
}