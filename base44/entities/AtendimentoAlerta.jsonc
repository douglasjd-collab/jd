{
  "name": "AtendimentoAlerta",
  "type": "object",
  "description": "Estado persistido do rel\u00f3gio de atendimento por conversa. Guarda desde quando o cliente aguarda resposta humana, o in\u00edcio do atendimento atual, adiamentos de alerta/revis\u00e3o e o marcador de \u00faltima mensagem j\u00e1 processada. Serve para o alerta sobreviver a reload e para n\u00e3o recalcular a conversa a cada consulta.",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "conversa_id": {
      "type": "string",
      "description": "ID da ConversaWhatsapp"
    },
    "connection_id": {
      "type": "string",
      "description": "ID da conex\u00e3o WhatsApp da conversa"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (denormalizado)"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone do cliente (denormalizado)"
    },
    "aguardando_desde": {
      "type": "string",
      "format": "date-time",
      "description": "Primeira mensagem do cliente ainda sem resposta humana. Vazio quando o cliente n\u00e3o est\u00e1 aguardando."
    },
    "atendimento_iniciado_em": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio do atendimento atual (\u00faltima resposta humana sem pend\u00eancia de cliente). Base do aviso de revis\u00e3o de 1 hora."
    },
    "revisao_adiada_ate": {
      "type": "string",
      "format": "date-time",
      "description": "Enquanto no futuro, o aviso de revis\u00e3o de 1 hora fica adiado (bot\u00e3o Continuar atendimento)."
    },
    "alerta_adiado_ate": {
      "type": "string",
      "format": "date-time",
      "description": "Enquanto no futuro, o popup de espera n\u00e3o interrompe para esta conversa. A pend\u00eancia continua vis\u00edvel."
    },
    "marcador": {
      "type": "string",
      "description": "Marcador da \u00faltima mensagem/status j\u00e1 processado. Se n\u00e3o mudou, o rel\u00f3gio n\u00e3o \u00e9 recalculado."
    },
    "status_conversa": {
      "type": "string",
      "description": "Status da conversa no \u00faltimo c\u00e1lculo"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo c\u00e1lculo"
    }
  },
  "required": [
    "empresa_id",
    "conversa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.empresa_id": "{{user.data.empresa_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.empresa_id": "{{user.data.empresa_id}}"
    },
    "update": {
      "data.empresa_id": "{{user.data.empresa_id}}"
    },
    "delete": {
      "data.empresa_id": "{{user.data.empresa_id}}"
    }
  }
}