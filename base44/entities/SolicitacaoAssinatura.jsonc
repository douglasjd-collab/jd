{
  "name": "SolicitacaoAssinatura",
  "type": "object",
  "properties": {
    "proposta_id": {
      "type": "string",
      "description": "ID da proposta vinculada"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "termo_autorizacao_id": {
      "type": "string",
      "description": "ID do TermoAutorizacao vinculado"
    },
    "termo_pdf_url": {
      "type": "string",
      "description": "URL do PDF do termo no momento do envio"
    },
    "cliente_nome_snapshot": {
      "type": "string"
    },
    "banco_snapshot": {
      "type": "string"
    },
    "tipo_operacao_snapshot": {
      "type": "string"
    },
    "contrato_snapshot": {
      "type": "string"
    },
    "valor_bruto_snapshot": {
      "type": "number"
    },
    "valor_liquido_snapshot": {
      "type": "number"
    },
    "valor_parcela_snapshot": {
      "type": "number"
    },
    "prazo_snapshot": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_cliente",
        "aguardando_testemunha1",
        "aguardando_testemunha2",
        "aguardando_representante",
        "em_assinatura",
        "aguardando_conferencia",
        "assinado",
        "recusado",
        "cancelado"
      ],
      "default": "aguardando_cliente"
    },
    "sequencial": {
      "type": "boolean",
      "default": true,
      "description": "Se cada assinatura s\u00f3 \u00e9 liberada ap\u00f3s a anterior"
    },
    "ordem_json": {
      "type": "string",
      "description": "JSON array com a ordem dos pap\u00e9is inclu\u00eddos (ex: [\"cliente\",\"testemunha1\",\"representante\"])"
    },
    "cliente_nome": {
      "type": "string"
    },
    "cliente_cpf": {
      "type": "string"
    },
    "cliente_telefone": {
      "type": "string"
    },
    "cliente_email": {
      "type": "string"
    },
    "cliente_token": {
      "type": "string"
    },
    "cliente_status": {
      "type": "string",
      "enum": [
        "pendente",
        "visualizado",
        "assinado",
        "recusado"
      ],
      "default": "pendente"
    },
    "cliente_data_assinatura": {
      "type": "string",
      "format": "date-time"
    },
    "cliente_assinatura_url": {
      "type": "string"
    },
    "cliente_evidencias_json": {
      "type": "string",
      "description": "JSON com evid\u00eancias digitais do cliente: selfie_url, selfie_hash, rg_frente_url, rg_frente_hash, rg_verso_url, rg_verso_hash, ip, navegador, sistema_operacional, idioma, resolucao_tela e timestamps de captura"
    },
    "cliente_analfabeto": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente \u00e9 analfabeto \u2014 assinatura \u00e9 por impress\u00e3o digital (f\u00edsica) + a rogo por parente de 1\u00ba grau"
    },
    "cliente_digital_url": {
      "type": "string",
      "description": "URL da foto/scan da impress\u00e3o digital do cliente analfabeto (upload do termo impresso e digitalizado)"
    },
    "rogo_nome": {
      "type": "string",
      "description": "Nome do parente de 1\u00ba grau que assina a rogo pelo cliente analfabeto"
    },
    "rogo_cpf": {
      "type": "string",
      "description": "CPF do parente que assina a rogo"
    },
    "rogo_parentesco": {
      "type": "string",
      "description": "Grau de parentesco do rogo (ex: pai, m\u00e3e, filho, filha, irm\u00e3o, irm\u00e3)"
    },
    "rogo_token": {
      "type": "string"
    },
    "rogo_status": {
      "type": "string",
      "enum": [
        "nao_aplicavel",
        "pendente",
        "visualizado",
        "assinado",
        "recusado"
      ],
      "default": "nao_aplicavel"
    },
    "rogo_data_assinatura": {
      "type": "string",
      "format": "date-time"
    },
    "rogo_assinatura_url": {
      "type": "string"
    },
    "rogo_evidencias_json": {
      "type": "string",
      "description": "JSON com evid\u00eancias digitais do rogo (mesma estrutura das evid\u00eancias do cliente)"
    },
    "testemunha1_nome": {
      "type": "string"
    },
    "testemunha1_cpf": {
      "type": "string"
    },
    "testemunha1_telefone": {
      "type": "string"
    },
    "testemunha1_email": {
      "type": "string"
    },
    "testemunha1_relacao": {
      "type": "string"
    },
    "testemunha1_token": {
      "type": "string"
    },
    "testemunha1_status": {
      "type": "string",
      "enum": [
        "nao_aplicavel",
        "pendente",
        "visualizado",
        "assinado",
        "recusado"
      ],
      "default": "nao_aplicavel"
    },
    "testemunha1_data_assinatura": {
      "type": "string",
      "format": "date-time"
    },
    "testemunha1_assinatura_url": {
      "type": "string"
    },
    "testemunha1_evidencias_json": {
      "type": "string",
      "description": "JSON com evid\u00eancias digitais da testemunha 1 (mesma estrutura das evid\u00eancias do cliente)"
    },
    "testemunha2_nome": {
      "type": "string"
    },
    "testemunha2_cpf": {
      "type": "string"
    },
    "testemunha2_telefone": {
      "type": "string"
    },
    "testemunha2_email": {
      "type": "string"
    },
    "testemunha2_relacao": {
      "type": "string"
    },
    "testemunha2_token": {
      "type": "string"
    },
    "testemunha2_status": {
      "type": "string",
      "enum": [
        "nao_aplicavel",
        "pendente",
        "visualizado",
        "assinado",
        "recusado"
      ],
      "default": "nao_aplicavel"
    },
    "testemunha2_data_assinatura": {
      "type": "string",
      "format": "date-time"
    },
    "testemunha2_assinatura_url": {
      "type": "string"
    },
    "testemunha2_evidencias_json": {
      "type": "string",
      "description": "JSON com evid\u00eancias digitais da testemunha 2 (mesma estrutura das evid\u00eancias do cliente)"
    },
    "representante_nome": {
      "type": "string"
    },
    "representante_cpf": {
      "type": "string"
    },
    "representante_cargo": {
      "type": "string"
    },
    "representante_telefone": {
      "type": "string"
    },
    "representante_email": {
      "type": "string"
    },
    "representante_token": {
      "type": "string"
    },
    "representante_status": {
      "type": "string",
      "enum": [
        "pendente",
        "visualizado",
        "assinado",
        "recusado"
      ],
      "default": "pendente"
    },
    "representante_data_assinatura": {
      "type": "string",
      "format": "date-time"
    },
    "representante_assinatura_url": {
      "type": "string"
    },
    "representante_evidencias_json": {
      "type": "string",
      "description": "JSON com evid\u00eancias digitais do representante (mesma estrutura das evid\u00eancias do cliente)"
    },
    "motivo_recusa": {
      "type": "string"
    },
    "recusado_por_papel": {
      "type": "string"
    },
    "conferido_por_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que conferiu/aprovou ou reprovou a assinatura"
    },
    "conferido_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que conferiu/aprovou ou reprovou"
    },
    "data_conferencia": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora em que a assinatura foi conferida (aprovada ou reprovada)"
    },
    "motivo_reprovacao": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o da assinatura (quando reprovada para refazer)"
    },
    "criado_por_id": {
      "type": "string"
    },
    "criado_por_nome": {
      "type": "string"
    },
    "data_criacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "proposta_id",
    "empresa_id",
    "status"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "update": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return user.perfil === 'admin' && record.empresa_id === user.empresa_id;"
    }
  }
}