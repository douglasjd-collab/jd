{
  "name": "ConversaWhatsapp",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (denormalizado)"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone do cliente com WhatsApp"
    },
    "whatsapp_id": {
      "type": "string",
      "description": "ID da conversa no WhatsApp/Evolution"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto de perfil do contato ou grupo"
    },
    "bloqueado": {
      "type": "boolean",
      "default": false,
      "description": "Se true, novas mensagens deste grupo/contato s\u00e3o ignoradas"
    },
    "atendimento_prioritario": {
      "type": "boolean",
      "default": false,
      "description": "Se true, conversa marcada como atendimento priorit\u00e1rio (estrela). N\u00e3o volta para Esperando por inatividade."
    },
    "prioritario_marcado_por_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que marcou a prioridade (estrela)"
    },
    "prioritario_marcado_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que marcou a prioridade"
    },
    "prioritario_marcado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a prioridade foi marcada"
    },
    "prioritario_removido_por_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que removeu a prioridade"
    },
    "prioritario_removido_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que removeu a prioridade"
    },
    "prioritario_removido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a prioridade foi removida"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "encerrada",
        "arquivada",
        "campanha"
      ],
      "default": "ativa",
      "description": "Status da conversa: ativa, encerrada, arquivada ou campanha (lead de disparo sem resposta)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "campanha",
        "normal"
      ],
      "default": "normal",
      "description": "Origem da conversa: campanha (disparo API Oficial) ou normal"
    },
    "cliente_respondeu": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente j\u00e1 respondeu a uma mensagem de campanha"
    },
    "data_primeira_resposta": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da primeira resposta do cliente ap\u00f3s campanha"
    },
    "ultima_mensagem": {
      "type": "string",
      "description": "\u00daltima mensagem enviada/recebida"
    },
    "data_ultima_mensagem": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima mensagem"
    },
    "ultimo_remetente": {
      "type": "string",
      "enum": [
        "cliente",
        "vendedor"
      ],
      "description": "Quem enviou a \u00faltima mensagem"
    },
    "usuario_responsavel_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pela conversa"
    },
    "usuario_responsavel_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio respons\u00e1vel"
    },
    "usuario_responsavel_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio autenticado dono da conversa (respons\u00e1vel padr\u00e3o da conex\u00e3o). Usado na autoriza\u00e7\u00e3o por conex\u00e3o e na RLS."
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do atendente atual (expira em 10 min sem intera\u00e7\u00e3o)"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do atendente atual"
    },
    "responsavel_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio autenticado do atendente atual. Usado na autoriza\u00e7\u00e3o por conex\u00e3o e na RLS."
    },
    "atendimento_transferido_para_id": {
      "type": "string",
      "description": "ID do respons\u00e1vel que recebeu a transfer\u00eancia. Identifica Transferidos sem encerrar a conversa; v\u00e1lido enquanto coincidir com o respons\u00e1vel atual."
    },
    "responsavel_expira_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando expira o atendimento ativo (10 min ap\u00f3s \u00faltimo envio)"
    },
    "acesso_pontual_user_ids_json": {
      "type": "string",
      "description": "JSON array com IDs de usu\u00e1rios que receberam acesso pontual por transfer\u00eancia. Vale enquanto a conversa tiver respons\u00e1vel ativo."
    },
    "transferencias_json": {
      "type": "string",
      "description": "JSON array com o hist\u00f3rico de transfer\u00eancias [{autor_id, autor_nome, data, origem_connection_id, origem_responsavel_id, origem_responsavel_nome, destino_colaborador_id, destino_user_id, destino_nome}]"
    },
    "tipo_conexao": {
      "type": "string",
      "enum": [
        "empresa",
        "usuario",
        "meta_oficial",
        "instagram"
      ],
      "default": "empresa",
      "description": "Canal/provedor ativo da conversa"
    },
    "canal_origem": {
      "type": "string",
      "enum": [
        "meta",
        "evolution",
        "instagram",
        "dapi"
      ],
      "description": "Canal de origem fixo da conversa"
    },
    "provider": {
      "type": "string",
      "enum": [
        "whatsapp_meta",
        "evolution",
        "instagram",
        "dapi"
      ],
      "description": "Provider t\u00e9cnico usado para envio/recebimento"
    },
    "locked_provider": {
      "type": "boolean",
      "default": false,
      "description": "Se true, o provider est\u00e1 travado"
    },
    "last_inbound_provider": {
      "type": "string",
      "description": "Provider da \u00faltima mensagem RECEBIDA"
    },
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador dono da inst\u00e2ncia"
    },
    "connection_id": {
      "type": "string",
      "description": "ID da WhatsappConnection ativa na conversa (multi-D-API). Recebida via webhook, determina qual conex\u00e3o usar no envio."
    },
    "instancia": {
      "type": "string",
      "description": "Nome da inst\u00e2ncia Evolution / session_id D-API"
    },
    "instance_id": {
      "type": "string",
      "description": "ID da inst\u00e2ncia Evolution"
    },
    "phone_number_id_meta": {
      "type": "string",
      "description": "Phone Number ID da API Meta"
    },
    "canal_atendimento": {
      "type": "string",
      "description": "Canal fixo de atendimento (legado)"
    },
    "canal_preferencial": {
      "type": "string",
      "description": "Canal preferencial (legado)"
    },
    "ultima_origem_recebida": {
      "type": "string",
      "description": "\u00daltima origem de mensagem recebida (diagn\u00f3stico)"
    }
  },
  "required": [
    "empresa_id",
    "cliente_telefone"
  ],
  "security": {
    "read": {
      "rule": "var u = user || {}; var dados = u.data || {}; var empresa = u.empresa_id || dados.empresa_id; var mapa = {}; try { mapa = JSON.parse(u.whatsapp_permissoes_json || dados.whatsapp_permissoes_json || '{}') || {}; } catch (e) { mapa = {}; } if (u.perfil === 'super_admin' || u.perfil === 'master') return true; if (!empresa) return true; if (record.empresa_id !== empresa) return false; var chaves = Object.keys(mapa); if (!chaves.length) { if (record.tipo_conexao === 'usuario' && record.colaborador_id) { if (['admin','gerente','funcionario'].indexOf(u.perfil) !== -1) return true; return record.colaborador_id === (u.colaborador_id || dados.colaborador_id); } return true; } var nivel = mapa[record.connection_id || ''] || 'sem_acesso'; if (nivel === 'todas') return true; if (nivel !== 'atribuidas') return false; var meus = [u.id, u.user_id, u.colaborador_id, dados.colaborador_id].filter(Boolean); var tem = function (v) { return !!v && meus.indexOf(v) !== -1; }; if (tem(record.usuario_responsavel_id) || tem(record.usuario_responsavel_user_id) || tem(record.responsavel_user_id)) return true; if (!record.responsavel_id) return false; if (tem(record.responsavel_id) || tem(record.atendimento_transferido_para_id)) return true; var pontual = []; try { pontual = JSON.parse(record.acesso_pontual_user_ids_json || '[]') || []; } catch (e) { pontual = []; } for (var i = 0; i < pontual.length; i++) { if (tem(pontual[i])) return true; } return false;"
    },
    "create": {
      "rule": "return true;"
    },
    "update": {
      "rule": "var u = user || {}; var dados = u.data || {}; var empresa = u.empresa_id || dados.empresa_id; var mapa = {}; try { mapa = JSON.parse(u.whatsapp_permissoes_json || dados.whatsapp_permissoes_json || '{}') || {}; } catch (e) { mapa = {}; } if (u.perfil === 'super_admin' || u.perfil === 'master') return true; if (!empresa) return true; if (record.empresa_id !== empresa) return false; var chaves = Object.keys(mapa); if (!chaves.length) return true; var nivel = mapa[record.connection_id || ''] || 'sem_acesso'; if (nivel === 'todas') return true; if (nivel !== 'atribuidas') return false; var meus = [u.id, u.user_id, u.colaborador_id, dados.colaborador_id].filter(Boolean); var tem = function (v) { return !!v && meus.indexOf(v) !== -1; }; if (tem(record.usuario_responsavel_id) || tem(record.usuario_responsavel_user_id) || tem(record.responsavel_user_id)) return true; if (!record.responsavel_id) return false; if (tem(record.responsavel_id) || tem(record.atendimento_transferido_para_id)) return true; var pontual = []; try { pontual = JSON.parse(record.acesso_pontual_user_ids_json || '[]') || []; } catch (e) { pontual = []; } for (var i = 0; i < pontual.length; i++) { if (tem(pontual[i])) return true; } return false;"
    },
    "delete": {
      "rule": "return user.perfil === 'admin' || user.perfil === 'super_admin';"
    }
  }
}