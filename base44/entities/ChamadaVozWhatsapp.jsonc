{
  "name": "ChamadaVozWhatsapp",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "conversa_id": {
      "type": "string",
      "description": "ID da ConversaWhatsapp vinculada"
    },
    "connection_id": {
      "type": "string",
      "description": "ID da conexão WhatsApp (D-API) que recebeu a chamada"
    },
    "call_id": {
      "type": "string",
      "description": "ID da chamada (callId) retornado pela D-API"
    },
    "cliente_telefone": {
      "type": "string",
      "description": "Telefone de quem ligou"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do contato (se conhecido)"
    },
    "status": {
      "type": "string",
      "enum": [
        "recebida",
        "visualizada",
        "atendendo",
        "em_atendimento",
        "encerrada",
        "recusada",
        "erro"
      ],
      "default": "recebida",
      "description": "Se o atendente já visualizou o popup da chamada"
    },
    "from_jid": {
      "type": "string"
    },
    "oferta_em": {
      "type": "string"
    },
    "atendente_id": {
      "type": "string"
    },
    "atendente_token": {
      "type": "string"
    },
    "erro_aceite": {
      "type": "string"
    },
    "destinatarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "empresa_id",
    "cliente_telefone",
    "call_id"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "return user.role === 'admin';"
    },
    "update": {
      "rule": "return user.role === 'admin';"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return user.perfil === 'admin' && record.empresa_id === user.empresa_id;"
    }
  }
}