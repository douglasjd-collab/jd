{
  "name": "Proposta",
  "type": "object",
  "properties": {
    "comissao_vendedor_comprovante_url": {
      "type": "string",
      "description": "Comprovante bancário do pagamento de comissão legado (PDF ou imagem)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "produto": {
      "type": "string",
      "enum": [
        "consorcio",
        "emprestimo",
        "financiamento"
      ],
      "description": "Tipo de produto"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (denormalizado)"
    },
    "cliente_cpf": {
      "type": "string",
      "description": "CPF do cliente (denormalizado)"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador responsável principal (legado)"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do colaborador responsável principal (legado)"
    },
    "responsavel_foto": {
      "type": "string",
      "description": "URL da foto do colaborador responsável principal (legado)"
    },
    "responsaveis_json": {
      "type": "string",
      "description": "JSON array com múltiplos responsáveis [{id, nome, foto}]"
    },
    "administradora_id": {
      "type": "string",
      "description": "ID da administradora/banco"
    },
    "administradora_nome": {
      "type": "string",
      "description": "Nome da administradora/banco"
    },
    "empresa_parceira_id": {
      "type": "string",
      "description": "ID da empresa parceira"
    },
    "empresa_parceira_nome": {
      "type": "string",
      "description": "Nome da empresa parceira (denormalizado)"
    },
    "grupo": {
      "type": "string",
      "description": "Código do grupo (consórcio)"
    },
    "cota": {
      "type": "string",
      "description": "Número da cota (consórcio)"
    },
    "contrato": {
      "type": "string",
      "description": "Número do contrato"
    },
    "chave_unica": {
      "type": "string",
      "description": "Chave única para deduplicação: banco_normalizado + _ + contrato (ex: happyconsig_1785552)"
    },
    "status": {
      "type": "string",
      "description": "Status da proposta (texto original/legado)"
    },
    "status_id": {
      "type": "string",
      "description": "ID do StatusProposta vinculado"
    },
    "data_venda": {
      "type": "string",
      "format": "date",
      "description": "Data da venda/proposta"
    },
    "valor_credito": {
      "type": "number",
      "description": "Valor do crédito/bem (Valor Bruto)"
    },
    "valor_liquido": {
      "type": "number",
      "description": "[EMPRÉSTIMO] Valor líquido liberado ao cliente (após descontos/taxas)"
    },
    "valor_comissao": {
      "type": "number",
      "description": "Valor da comissão estimada"
    },
    "comissao_recebida": {
      "type": "number",
      "default": 0,
      "description": "Comissão já recebida"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "origem_tabela": {
      "type": "string",
      "description": "Tabela original (para rastreamento de migração)"
    },
    "origem_id": {
      "type": "string",
      "description": "ID original (para rastreamento de migração)"
    },
    "tabela_comissao_id": {
      "type": "string",
      "description": "ID da TabelaEmprestimo vinculada"
    },
    "tabela_comissao_nome": {
      "type": "string",
      "description": "Nome da tabela de comissão (denormalizado)"
    },
    "consorcio_tabela_id": {
      "type": "string",
      "description": "[CONSÓRCIO] ID da tabela de consórcio"
    },
    "consorcio_tabela_nome": {
      "type": "string",
      "description": "[CONSÓRCIO] Nome da tabela"
    },
    "consorcio_plano_id": {
      "type": "string",
      "description": "[CONSÓRCIO] ID do plano"
    },
    "consorcio_tipo_bem": {
      "type": "string",
      "enum": [
        "automovel",
        "imovel",
        "motocicleta",
        "servico",
        "bens_moveis"
      ],
      "description": "[CONSÓRCIO] Tipo do bem"
    },
    "consorcio_prazo": {
      "type": "number",
      "description": "[CONSÓRCIO] Prazo em meses"
    },
    "consorcio_taxa_adm": {
      "type": "number",
      "description": "[CONSÓRCIO] Taxa de administração %"
    },
    "consorcio_percentual_comissao": {
      "type": "number",
      "description": "[CONSÓRCIO] Percentual de comissão"
    },
    "emprestimo_tipo": {
      "type": "string",
      "description": "[EMPRÉSTIMO] Tipo de empréstimo (slug do TipoEmprestimo)"
    },
    "emprestimo_convenio_id": {
      "type": "string",
      "description": "[EMPRÉSTIMO] ID do convênio"
    },
    "emprestimo_convenio_nome": {
      "type": "string",
      "description": "[EMPRÉSTIMO] Nome do convênio"
    },
    "emprestimo_numero_beneficio": {
      "type": "string",
      "description": "[EMPRÉSTIMO] Número do benefício"
    },
    "emprestimo_numero_ade": {
      "type": "string",
      "description": "[EMPRÉSTIMO] Número ADE"
    },
    "emprestimo_prazo": {
      "type": "number",
      "description": "[EMPRÉSTIMO] Prazo em meses"
    },
    "emprestimo_valor_parcela": {
      "type": "number",
      "description": "[EMPRÉSTIMO] Valor da parcela do contrato"
    },
    "emprestimo_banco_anterior": {
      "type": "string",
      "description": "[EMPRÉSTIMO] Banco anterior (portabilidade)"
    },
    "emprestimo_saldo_devedor": {
      "type": "number",
      "description": "[EMPRÉSTIMO] Saldo devedor"
    },
    "emprestimo_data_liberacao": {
      "type": "string",
      "format": "date",
      "description": "[EMPRÉSTIMO] Data de liberação / Pagamento ao cliente"
    },
    "data_comissao_recebida": {
      "type": "string",
      "format": "date",
      "description": "[EMPRÉSTIMO] Data de recebimento da comissão pelo banco"
    },
    "comissao_banco_recebida": {
      "type": "boolean",
      "default": false,
      "description": "[EMPRÉSTIMO] Se a comissão do banco já foi recebida pela empresa"
    },
    "comissao_vendedor_paga": {
      "type": "boolean",
      "default": false,
      "description": "[EMPRÉSTIMO] Se a comissão foi paga ao vendedor"
    },
    "comissao_vendedor_agendada": {
      "type": "boolean",
      "default": false,
      "description": "[EMPRESTIMO] Se a comissao ja esta reservada em lote programado"
    },
    "comissao_vendedor_lote_agendado_id": {
      "type": "string",
      "description": "[EMPRESTIMO] ID do lote de pagamento programado"
    },
    "comissao_vendedor_lote_agendado_codigo": {
      "type": "string",
      "description": "[EMPRESTIMO] Codigo do lote de pagamento programado"
    },
    "comissao_vendedor_data_agendamento": {
      "type": "string",
      "format": "date",
      "description": "[EMPRESTIMO] Data prevista para pagamento ao vendedor"
    },
    "comissao_vendedor_data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "[EMPRÉSTIMO] Data do pagamento ao vendedor"
    },
    "comissao_vendedor_forma_pagamento": {
      "type": "string",
      "description": "[EMPRÉSTIMO] Forma de pagamento ao vendedor"
    },
    "percentual_comissao_vendedor": {
      "type": "number",
      "description": "[EMPRÉSTIMO] Percentual de comissão pago ao vendedor"
    },
    "valor_comissao_vendedor_pago": {
      "type": "number",
      "description": "[EMPRÉSTIMO] Valor efetivamente pago ao vendedor"
    },
    "cip_data_entrada": {
      "type": "string",
      "format": "date",
      "description": "[CIP] Data de entrada no status Aguardando CIP"
    },
    "cip_data_retorno_prevista": {
      "type": "string",
      "format": "date",
      "description": "[CIP] Data prevista de retorno do saldo (5 dias úteis)"
    },
    "cip_valor_previsto": {
      "type": "number",
      "description": "[CIP] Valor do saldo previsto para retorno"
    },
    "financiamento_tipo": {
      "type": "string",
      "enum": [
        "VEICULO",
        "MOTOCICLETA",
        "CAMINHAO",
        "IMOVEL"
      ],
      "description": "[FINANCIAMENTO] Tipo de financiamento"
    },
    "financiamento_banco": {
      "type": "string",
      "description": "[FINANCIAMENTO] Nome do banco"
    },
    "financiamento_valor_bem": {
      "type": "number",
      "description": "[FINANCIAMENTO] Valor do bem"
    },
    "financiamento_valor_financiado": {
      "type": "number",
      "description": "[FINANCIAMENTO] Valor financiado"
    },
    "financiamento_entrada": {
      "type": "number",
      "description": "[FINANCIAMENTO] Valor da entrada"
    },
    "financiamento_prazo": {
      "type": "number",
      "description": "[FINANCIAMENTO] Prazo em meses"
    },
    "financiamento_parcela": {
      "type": "number",
      "description": "[FINANCIAMENTO] Valor da parcela"
    },
    "financiamento_data_liberacao": {
      "type": "string",
      "format": "date",
      "description": "[FINANCIAMENTO] Data de liberação"
    },
    "tipo_importacao_original": {
      "type": "string",
      "description": "Tipo vindo do arquivo de importação (quando não mapeado)"
    },
    "pendente_vinculacao_tipo": {
      "type": "boolean",
      "default": false,
      "description": "Sinaliza que o tipo de empréstimo precisa ser vinculado manualmente"
    },
    "banco_id": {
      "type": "string",
      "description": "[API] ID do banco na entidade Banco"
    },
    "configuracao_api_id": {
      "type": "string",
      "description": "[API] ID da ConfiguracaoApiBanco"
    },
    "codigo_proposta_banco": {
      "type": "string",
      "description": "[API] Código da proposta retornado pelo banco"
    },
    "codigo_operacao_banco": {
      "type": "string",
      "description": "[API] Código da operação retornado pelo banco"
    },
    "status_atual": {
      "type": "string",
      "description": "[API] Status atual convertido para o padrão interno"
    },
    "status_externo_atual": {
      "type": "string",
      "description": "[API] Status externo retornado pela API"
    },
    "data_status_atual": {
      "type": "string",
      "format": "date-time",
      "description": "[API] Data do status atual"
    },
    "data_ultima_atualizacao_api": {
      "type": "string",
      "format": "date-time",
      "description": "[API] Data da última atualização via API"
    },
    "api_sincronizada": {
      "type": "boolean",
      "default": false,
      "description": "[API] Se foi sincronizada com a API"
    },
    "api_ultima_tentativa": {
      "type": "string",
      "format": "date-time",
      "description": "[API] Data da última tentativa de sincronização"
    },
    "api_ultimo_erro": {
      "type": "string",
      "description": "[API] Último erro de sincronização"
    },
    "payload_ultima_resposta_json": {
      "type": "string",
      "description": "[API] JSON bruto da última resposta da API"
    },
    "finantobank_id": {
      "type": "string",
      "description": "[FINANTOBANK] ID único da proposta no FinantoBank"
    },
    "finantobank_tipo": {
      "type": "string",
      "description": "[FINANTOBANK] Tipo de operação: novo, portabilidade, refinanciamento"
    },
    "status_finantobank": {
      "type": "string",
      "description": "[FINANTOBANK] Status exato retornado pelo FinantoBank"
    },
    "data_ultima_atualizacao_finantobank": {
      "type": "string",
      "format": "date-time",
      "description": "[FINANTOBANK] Data/hora da última atualização do status"
    },
    "finantobank_saldo_aprovado": {
      "type": "boolean",
      "default": false,
      "description": "[FINANTOBANK] Se o saldo foi aprovado"
    },
    "finantobank_valor_parcela": {
      "type": "number",
      "description": "[FINANTOBANK] Valor da parcela retornado pela simulação"
    },
    "finantobank_taxa": {
      "type": "number",
      "description": "[FINANTOBANK] Taxa de juros retornada pela simulação"
    },
    "finantobank_iof": {
      "type": "number",
      "description": "[FINANTOBANK] IOF retornado pela simulação"
    },
    "payload_ultima_resposta_finantobank": {
      "type": "string",
      "description": "[FINANTOBANK] JSON completo da última resposta da API do FinantoBank"
    },
    "anexos_json": {
      "type": "string",
      "description": "JSON array de anexos da proposta [{nome, url, tipo, data_upload}]"
    },
    "testemunha1_nome": {
      "type": "string",
      "description": "[TESTEMUNHA 1] Nome completo"
    },
    "testemunha1_cpf": {
      "type": "string",
      "description": "[TESTEMUNHA 1] CPF"
    },
    "testemunha1_telefone": {
      "type": "string",
      "description": "[TESTEMUNHA 1] Telefone"
    },
    "testemunha1_endereco": {
      "type": "string",
      "description": "[TESTEMUNHA 1] Endereço"
    },
    "testemunha2_nome": {
      "type": "string",
      "description": "[TESTEMUNHA 2] Nome completo"
    },
    "testemunha2_cpf": {
      "type": "string",
      "description": "[TESTEMUNHA 2] CPF"
    },
    "testemunha2_telefone": {
      "type": "string",
      "description": "[TESTEMUNHA 2] Telefone"
    },
    "testemunha2_endereco": {
      "type": "string",
      "description": "[TESTEMUNHA 2] Endereço"
    },
    "cliente_analfabeto": {
      "type": "boolean",
      "default": false,
      "description": "[ANALFABETO] Se o cliente é analfabeto — termo será impresso para impressão digital + assinatura a rogo por parente de 1º grau + 2 testemunhas obrigatórias"
    },
    "rogo_nome": {
      "type": "string",
      "description": "[ANALFABETO] Nome do parente de 1º grau que assina a rogo pelo cliente"
    },
    "rogo_cpf": {
      "type": "string",
      "description": "[ANALFABETO] CPF do parente que assina a rogo"
    },
    "rogo_parentesco": {
      "type": "string",
      "description": "[ANALFABETO] Grau de parentesco do rogo (ex: pai, mãe, filho, filha, irmão, irmã)"
    },
    "banco_origem_id": {
      "type": "string",
      "description": "Banco filho identificado antes de resolver o banco pai."
    },
    "banco_origem_nome": {
      "type": "string",
      "description": "Nome original do banco recebido na planilha de produção."
    }
  },
  "required": [
    "empresa_id",
    "produto"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; if (user.perfil === 'parceiro') return record.vendedor_id === user.id; if (user.perfil === 'colaborador' || user.perfil === 'funcionario' || user.perfil === 'colaborador_vendedor') return record.empresa_id === user.empresa_id; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor','parceiro'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "update": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; if (user.perfil === 'parceiro') return record.vendedor_id === user.id; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    }
  }
}
