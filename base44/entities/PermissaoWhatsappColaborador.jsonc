{
  "name": "PermissaoWhatsappColaborador",
  "type": "object",
  "description": "Permiss\u00e3o de acesso ao WhatsApp por colaborador e por conex\u00e3o. Define se o colaborador n\u00e3o tem acesso, v\u00ea somente as conversas atribu\u00eddas a ele, ou todas as conversas daquela conex\u00e3o, e quem \u00e9 o respons\u00e1vel padr\u00e3o das novas conversas da conex\u00e3o.",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "colaborador_id": {
      "type": "string",
      "description": "ID do Colaborador"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador (denormalizado)"
    },
    "colaborador_email": {
      "type": "string",
      "description": "E-mail do colaborador (denormalizado)"
    },
    "colaborador_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio autenticado vinculado ao colaborador"
    },
    "connection_id": {
      "type": "string",
      "description": "ID da WhatsappConnection"
    },
    "connection_nome": {
      "type": "string",
      "description": "Nome da conex\u00e3o (denormalizado)"
    },
    "nivel_acesso": {
      "type": "string",
      "enum": [
        "sem_acesso",
        "atribuidas",
        "todas"
      ],
      "default": "atribuidas",
      "description": "sem_acesso = n\u00e3o v\u00ea nada da conex\u00e3o; atribuidas = somente conversas atribu\u00eddas/transferidas para ele; todas = todas as conversas da conex\u00e3o"
    },
    "responsavel_padrao": {
      "type": "boolean",
      "default": false,
      "description": "Respons\u00e1vel padr\u00e3o das novas conversas desta conex\u00e3o. Apenas um colaborador por conex\u00e3o."
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "atualizado_por_id": {
      "type": "string"
    },
    "atualizado_por_nome": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "colaborador_id",
    "connection_id",
    "nivel_acesso"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.colaborador_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}