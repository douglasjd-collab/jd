{
  "name": "ClienteDocumento",
  "type": "object",
  "description": "Documentos (CNH, RG, comprovante de resid\u00eancia, etc.) vinculados a um Cliente. Guarda metadados de envio, campos extra\u00eddos por OCR/AI e hist\u00f3rico de a\u00e7\u00f5es (view/download/replace/delete).",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (denormalizado para RLS)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do Cliente vinculado"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL p\u00fablica do arquivo no storage"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome original do arquivo enviado"
    },
    "arquivo_tamanho": {
      "type": "number",
      "description": "Tamanho do arquivo em bytes"
    },
    "arquivo_mime": {
      "type": "string",
      "description": "MIME type do arquivo"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "cnh",
        "rg",
        "comprovante_residencia",
        "comprovante_renda",
        "outro"
      ],
      "description": "Tipo do documento identificado pela leitura autom\u00e1tica"
    },
    "lado": {
      "type": "string",
      "enum": [
        "frente",
        "verso",
        "completo",
        "nao_identificado"
      ],
      "default": "nao_identificado"
    },
    "campos_extraidos_json": {
      "type": "string",
      "description": "JSON completo dos campos extra\u00eddos pela IA (com confian\u00e7a por campo) \u2014 snapshot do que foi lido no documento"
    },
    "campos_preenchidos_json": {
      "type": "string",
      "description": "JSON array com os campos do CRM efetivamente preenchidos a partir deste documento [{campo_crm, valor, confianca}] \u2014 auditoria do que foi aplicado"
    },
    "nivel_confianca": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baixa",
        "nao_identificado"
      ],
      "default": "nao_identificado"
    },
    "enviado_por_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que enviou o documento"
    },
    "enviado_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que enviou o documento"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "substitui_id": {
      "type": "string",
      "description": "ID do documento anterior que foi substitu\u00eddo por este"
    },
    "excluido": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete: se true, o documento foi exclu\u00eddo (n\u00e3o aparece mais na lista)"
    },
    "excluido_por_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que excluiu"
    },
    "excluido_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que excluiu"
    },
    "data_exclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da exclus\u00e3o"
    },
    "historico_acoes_json": {
      "type": "string",
      "description": "JSON array com hist\u00f3rico de a\u00e7\u00f5es secund\u00e1rias (visualizou, baixou, substituiu) [{acao, usuario_id, usuario_nome, dataHora}]"
    }
  },
  "required": [
    "empresa_id",
    "cliente_id",
    "arquivo_url",
    "tipo_documento"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor','parceiro'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "update": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    }
  }
}