{
  "name": "ListaContatosImportada",
  "type": "object",
  "description": "Listas de contatos importadas para uso em campanhas de disparo em massa.",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome": {
      "type": "string",
      "description": "Nome da lista"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/observa\u00e7\u00e3o da lista"
    },
    "total_contatos": {
      "type": "number",
      "default": 0,
      "description": "Total de clientes (contatos \u00fanicos) na lista"
    },
    "total_telefones": {
      "type": "number",
      "default": 0,
      "description": "Total de telefones (soma de todos os n\u00fameros de todos os contatos) \u2014 usado para estimar \u043e\u0431\u044a\u0435\u043c do disparo."
    },
    "contatos_json": {
      "type": "string",
      "description": "JSON array de contatos [{nome, cpf, cidade, email, telefone (principal), telefones: [{numero, tipo, is_principal}]}] (snapshot da importa\u00e7\u00e3o)."
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo original importado"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome do arquivo original"
    },
    "data_importacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da importa\u00e7\u00e3o"
    },
    "criado_por_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que importou"
    },
    "criado_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que importou"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "arquivada"
      ],
      "default": "ativa",
      "description": "Status da lista"
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "total_contatos"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "update": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return user.perfil === 'admin' && record.empresa_id === user.empresa_id;"
    }
  }
}