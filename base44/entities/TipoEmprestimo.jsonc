{
  "name": "TipoEmprestimo",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome": {
      "type": "string",
      "description": "Nome do tipo (ex: Novo, Refinanciamento, Cart\u00e3o Consignado)"
    },
    "slug": {
      "type": "string",
      "description": "C\u00f3digo interno (ex: NOVO, REFINANCIAMENTO, CARTAO_CONSIGNADO)"
    },
    "aliases_importacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de nomes que v\u00eam na importa\u00e7\u00e3o e mapeiam para este tipo, v\u00e1lidos para qualquer origem"
    },
    "aliases_por_origem": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "V\u00ednculos v\u00e1lidos apenas para uma origem (banco), no formato \"origem|descri\u00e7\u00e3o\" com ambos normalizados (sem acentos, min\u00fasculo, espa\u00e7os reduzidos). Usado quando a mesma descri\u00e7\u00e3o significa tipos diferentes em bancos diferentes."
    },
    "tipo_padrao_sem_descricao": {
      "type": "boolean",
      "default": false,
      "description": "Define o tipo aplicado quando o arquivo de importa\u00e7\u00e3o n\u00e3o informa o tipo do empr\u00e9stimo. Apenas um tipo da empresa deve estar marcado."
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "slug"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin', 'gerente'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "update": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin', 'gerente'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return user.perfil === 'admin' && record.empresa_id === user.empresa_id;"
    }
  }
}