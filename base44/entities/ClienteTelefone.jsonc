{
  "name": "ClienteTelefone",
  "type": "object",
  "description": "Telefones vinculados a um Cliente (rela\u00e7\u00e3o 1 cliente -> N telefones). Suporta m\u00faltiplos telefones por cliente (celular, fixo, comercial, residencial, WhatsApp, recado, etc).",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (denormalizado para RLS)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do Cliente vinculado"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone normalizado (somente d\u00edgitos, com DDI/DDD)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "celular",
        "whatsapp",
        "comercial",
        "residencial",
        "recado",
        "fixo",
        "contato",
        "outro"
      ],
      "default": "celular",
      "description": "Tipo/classifica\u00e7\u00e3o do telefone"
    },
    "is_whatsapp": {
      "type": "boolean",
      "default": false,
      "description": "Indica\u00e7\u00e3o se o n\u00famero possui WhatsApp"
    },
    "is_principal": {
      "type": "boolean",
      "default": false,
      "description": "Indica se \u00e9 o telefone principal de contato do cliente"
    },
    "header_origem": {
      "type": "string",
      "description": "Nome da coluna no arquivo de origem (importa\u00e7\u00e3o) que gerou este telefone"
    },
    "origem": {
      "type": "string",
      "enum": [
        "importacao_lista",
        "manual",
        "importacao_crm"
      ],
      "default": "importacao_lista",
      "description": "Origem do registro de telefone"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo",
      "description": "Status do telefone"
    }
  },
  "required": [
    "empresa_id",
    "cliente_id",
    "telefone"
  ],
  "security": {
    "read": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return record.empresa_id === user.empresa_id;"
    },
    "create": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor','parceiro'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "update": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return ['admin','gerente','vendedor','colaborador','funcionario','colaborador_vendedor'].includes(user.perfil) && record.empresa_id === user.empresa_id;"
    },
    "delete": {
      "rule": "if (user.perfil === 'super_admin' || user.perfil === 'master') return true; if (!user.empresa_id) return false; return user.perfil === 'admin' && record.empresa_id === user.empresa_id;"
    }
  }
}