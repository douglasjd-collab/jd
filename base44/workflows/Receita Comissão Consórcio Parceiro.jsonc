{
  "name": "Receita Comiss\u00e3o Cons\u00f3rcio Parceiro",
  "description": "Cria automaticamente uma receita no Meu Financeiro do parceiro quando uma comiss\u00e3o de cons\u00f3rcio \u00e9 quitada",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"quitado\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PagamentoComissaoLote"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "receita_comiss_o_cons_rcio_parceiro",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "criarReceitaComissaoParceiro",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "criarReceitaComissaoParceiro"
  }
}