{
  "name": "IA Funil - An\u00e1lise de \u00c1udio do Cliente",
  "description": "Quando o cliente envia um \u00e1udio no WhatsApp, transcreve, analisa com IA e atualiza o funil (cria/move oportunidade, registra hist\u00f3rico e agenda pr\u00f3ximo contato).",
  "trigger": {
    "condition": "${ ((.trigger.data.tipo_conteudo == \"audio\") and (.trigger.data.remetente == \"cliente\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "MensagemWhatsapp"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ia_funil_an_lise_de_udio_do_cliente",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processarAudioFunilIA",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processarAudioFunilIA"
  }
}